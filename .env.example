# ---------------------------------------------------------------------------
# Firebase client configuration — PUBLIC client values.
# These ship in the browser bundle by design; they are not secrets.
# Never put service-account / Admin SDK credentials in any VITE_ variable.
#
# MANUAL CONFIGURATION REQUIRED: copy this file to .env.local and fill in the
# values from Firebase Console → Project settings → Your apps → SDK setup.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Emulator switch.
#   true  → Auth/Firestore/Storage point at the local Firebase Emulator Suite
#           (requires `npm run emulators` running in another terminal).
#   false → connects to the real Firebase project above.
# .env.development sets this to true so `npm run dev` NEVER touches production.
# ---------------------------------------------------------------------------

VITE_USE_FIREBASE_EMULATORS=true

# ---------------------------------------------------------------------------
# Production site URL (no trailing slash). Used for canonical URLs, Open
# Graph tags, and the sitemap. Required for production builds.
# ---------------------------------------------------------------------------

VITE_SITE_URL=

# ---------------------------------------------------------------------------
# Optional: Firebase App Check site key (e.g. reCAPTCHA v3 site key).
# Leave empty to disable App Check. Optional for local development; the app
# must run without it.
# ---------------------------------------------------------------------------

VITE_FIREBASE_APPCHECK_SITE_KEY=
